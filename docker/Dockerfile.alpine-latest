FROM alpine:latest

RUN apk add \
    py3-clang \
    clang-dev \
    musl-dev \
    g++ \
    make

ARG UID=1000
ARG GID=1000
ARG ARCHIVE
ARG WORKDIR
ARG VENV

WORKDIR ${WORKDIR}

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PYTEST_ADDOPTS "-p no:cacheprovider"
ENV MYPY_CACHE_DIR "/dev/null"
ENV RUFF_NO_CACHE "true"

ADD ${ARCHIVE} .

RUN sh venv ${VENV}

ENV PATH="${VENV}/bin:${PATH}"

USER ${UID}:${GID}
